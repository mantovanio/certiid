# Copie este arquivo para .env e preencha com seus dados reais
# No GitHub Actions, configure como Secrets em Settings > Secrets > Actions
# No Portainer, insira na seção "Environment variables" do stack

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=coloque_sua_publishable_key_aqui
VITE_SUPABASE_ANON_KEY=opcional_compat_legado
SUPABASE_SECRET_KEY=coloque_sua_secret_key_aqui
SUPABASE_SERVICE_ROLE_KEY=opcional_compat_legado
